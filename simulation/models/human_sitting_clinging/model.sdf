<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="human_sitting_clinging">
    <static>true</static>
    <link name="body_link">
      <!-- 3D Volumetric Humanoid Mesh with Photorealistic Texture -->
      <visual name="survivor_mesh">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://human_sitting_clinging/meshes/sitting_huddled.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.15 0.10 1.0</ambient>
          <diffuse>0.95 0.15 0.10 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>

      <!-- Physical 3D Collision Volume -->
      <collision name="col">
        <pose>0.1 0 0.5 0 0 0</pose>
        <geometry><box><size>0.6 0.55 0.9</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
