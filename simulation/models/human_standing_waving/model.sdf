<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="human_standing_waving">
    <static>true</static>
    <link name="body_link">
      <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
        <temperature>310.0</temperature>
      </plugin>
      <!-- 3D Volumetric Humanoid Mesh with Photorealistic Texture -->
      <visual name="survivor_mesh">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://human_standing_waving/meshes/standing_waving.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.95 0.45 0.08 1.0</ambient>
          <diffuse>1.0 0.50 0.10 1.0</diffuse>
          <emissive>0.35 0.18 0.05 1.0</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/survivor_waving.png</albedo_map>
              <roughness>0.5</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Physical 3D Capsule Collision -->
      <collision name="col">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry><capsule><radius>0.26</radius><length>1.4</length></capsule></geometry>
      </collision>
    </link>
  </model>
</sdf>
