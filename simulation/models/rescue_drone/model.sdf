<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="rescue_drone">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>

    <!-- Main Airframe Link -->
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.025</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.025</iyy>
          <iyz>0.0</iyz>
          <izz>0.045</izz>
        </inertia>
      </inertial>

      <!-- Center Body Chassis -->
      <collision name="chassis_collision">
        <geometry><box><size>0.4 0.4 0.12</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.4 0.4 0.12</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.12 1.0</ambient>
          <diffuse>0.2 0.2 0.25 1.0</diffuse>
        </material>
      </visual>

      <!-- Front Left Arm (Motor 1) -->
      <visual name="arm_fl_visual">
        <pose>0.18 0.18 0 0 0 0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.1 0.7 0.9 1.0</ambient><diffuse>0.1 0.7 0.9 1.0</diffuse></material>
      </visual>

      <!-- Front Right Arm (Motor 2) -->
      <visual name="arm_fr_visual">
        <pose>0.18 -0.18 0 0 0 -0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.1 0.7 0.9 1.0</ambient><diffuse>0.1 0.7 0.9 1.0</diffuse></material>
      </visual>

      <!-- Rear Left Arm (Motor 3) -->
      <visual name="arm_rl_visual">
        <pose>-0.18 0.18 0 0 0 -0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1.0</ambient><diffuse>0.9 0.1 0.1 1.0</diffuse></material>
      </visual>

      <!-- Rear Right Arm (Motor 4) -->
      <visual name="arm_rr_visual">
        <pose>-0.18 -0.18 0 0 0 0.785</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.28</length></cylinder></geometry>
        <material><ambient>0.8 0.1 0.1 1.0</ambient><diffuse>0.9 0.1 0.1 1.0</diffuse></material>
      </visual>

      <!-- Downward/Angled Rescue Searchlight (Night Operations) -->
      <light type="spot" name="searchlight">
        <pose>0.1 0 -0.05 0 0.785 0</pose> <!-- Angled 45 deg down forward -->
        <diffuse>1.0 0.95 0.8 1.0</diffuse>
        <specular>0.8 0.8 0.8 1.0</specular>
        <attenuation>
          <range>40</range>
          <constant>0.2</constant>
          <linear>0.05</linear>
          <quadratic>0.005</quadratic>
        </attenuation>
        <spot>
          <inner_angle>0.3</inner_angle>
          <outer_angle>0.6</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <direction>0 0 -1</direction>
      </light>

      <!-- Downward/Forward RGB Camera Sensor -->
      <sensor name="camera" type="camera">
        <pose>0.15 0 -0.05 0 0.52 0</pose> <!-- Tilted 30 degrees down -->
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov> <!-- 80 deg FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>

      <!-- IMU Sensor -->
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>imu</topic>
      </sensor>
    </link>

    <!-- Velocity / Odometry Control System Plugin -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>odometry</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
