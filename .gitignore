# Environment & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
*.local

# ROS 2 & Colcon Build Artifacts
build/
install/
log/
simulation/build/
simulation/install/
simulation/log/
COLCON_IGNORE
*.log

# Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
ai_service/.venv/
ai_service/env/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Node.js / NestJS Backend & Digital Twin Frontend
node_modules/
backend/node_modules/
backend/dist/
dist/
dist-ssr/
out/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# IDEs & System Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Temporary & Scratch Files
scratch/
tmp/
*.tmp
*.bak
